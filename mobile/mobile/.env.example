# Firebase Console > Project settings > General > Your apps > Web app.
# These EXPO_PUBLIC values identify the Firebase project; they are not server secrets.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Must match the region used by firebase/functions/src/index.ts.
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=europe-west1

# Unity LevelPlay / ironSource identifiers (public ad identifiers, not secrets).
EXPO_PUBLIC_IRONSRC_IOS_APP_ID=26d9fb51d
EXPO_PUBLIC_IRONSRC_IOS_REWARDED_ID=nt81b397cbikquwn
EXPO_PUBLIC_IRONSRC_IOS_INTERSTITIAL_ID=bini0fp5s7f2cuni
EXPO_PUBLIC_IRONSRC_IOS_NATIVE_ID=
EXPO_PUBLIC_IRONSRC_ANDROID_APP_ID=
EXPO_PUBLIC_IRONSRC_ANDROID_REWARDED_ID=
EXPO_PUBLIC_IRONSRC_ANDROID_INTERSTITIAL_ID=
EXPO_PUBLIC_IRONSRC_ANDROID_NATIVE_ID=
