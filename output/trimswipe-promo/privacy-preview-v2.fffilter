[0:v]split=7[home_src][swipe_src][confirm_src][recap_src][stats_a_src][stats_b_src][stats_c_src];

[home_src]
trim=start=0:end=2.2,
setpts=PTS-STARTPTS,
fps=30,
setpts=N/(30*TB),
scale=886:1920:flags=lanczos,
unsharp=5:5:0.35:3:3:0,
fade=t=out:st=2.05:d=0.15:color=0xf6f0e5,
format=yuv420p
[home];

[swipe_src]
trim=start=2.7:end=11.5,
setpts=PTS-STARTPTS,
fps=30,
setpts=N/(30*TB),
split=2[swipe_base][swipe_private];
[swipe_private]
crop=444:615:0:105,
gblur=sigma=55:steps=4,
drawbox=x=0:y=0:w=iw:h=ih:color=0x315f7d@0.24:t=fill
[swipe_blur];
[swipe_base][swipe_blur]
overlay=0:105,
scale=886:1920:flags=lanczos,
unsharp=5:5:0.35:3:3:0,
fade=t=in:st=0:d=0.15:color=0xf6f0e5,
fade=t=out:st=8.65:d=0.15:color=0xf6f0e5,
format=yuv420p
[swipe];

[confirm_src]
trim=start=31.8:end=34.8,
setpts=PTS-STARTPTS,
fps=30,
setpts=N/(30*TB),
split=2[confirm_base][confirm_private];
[confirm_private]
crop=70:565:45:135,
gblur=sigma=22:steps=4,
drawbox=x=0:y=0:w=iw:h=ih:color=0x315f7d@0.20:t=fill
[confirm_blur];
[confirm_base][confirm_blur]
overlay=45:135,
scale=886:1920:flags=lanczos,
unsharp=5:5:0.35:3:3:0,
fade=t=in:st=0:d=0.15:color=0xf6f0e5,
fade=t=out:st=2.85:d=0.15:color=0xf6f0e5,
format=yuv420p
[confirm];

[recap_src]
trim=start=37:end=41,
setpts=PTS-STARTPTS,
fps=30,
setpts=N/(30*TB),
scale=886:1920:flags=lanczos,
unsharp=5:5:0.35:3:3:0,
fade=t=in:st=0:d=0.15:color=0xf6f0e5,
fade=t=out:st=3.85:d=0.15:color=0xf6f0e5,
format=yuv420p
[recap];

[stats_a_src]
trim=start=48:end=49.5,
setpts=PTS-STARTPTS,
fps=30,
setpts=N/(30*TB),
scale=886:1920:flags=lanczos,
unsharp=5:5:0.35:3:3:0,
fade=t=in:st=0:d=0.15:color=0xf6f0e5,
fade=t=out:st=1.35:d=0.15:color=0xf6f0e5,
format=yuv420p
[stats_a];

[stats_b_src]
trim=start=51:end=54,
setpts=PTS-STARTPTS,
fps=30,
setpts=N/(30*TB),
scale=886:1920:flags=lanczos,
unsharp=5:5:0.35:3:3:0,
fade=t=in:st=0:d=0.15:color=0xf6f0e5,
fade=t=out:st=2.85:d=0.15:color=0xf6f0e5,
format=yuv420p
[stats_b];

[stats_c_src]
trim=start=55:end=57.5,
setpts=PTS-STARTPTS,
fps=30,
setpts=N/(30*TB),
scale=886:1920:flags=lanczos,
unsharp=5:5:0.35:3:3:0,
fade=t=in:st=0:d=0.15:color=0xf6f0e5,
format=yuv420p
[stats_c];

[home][swipe][confirm][recap][stats_a][stats_b][stats_c]
concat=n=7:v=1:a=0,
fps=30,
trim=duration=25,
setpts=N/(30*TB)
[video_out]
